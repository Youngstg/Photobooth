# CuteSnaps Environment Configuration Example
# Salin file ini menjadi .env untuk konfigurasi lokal atau pasang di Environment Variables hosting (Vercel / VPS).

# ==============================================================================
# 1. WebRTC STUN & TURN Configuration (Wajib untuk mode Duo lintas jaringan)
# ==============================================================================
# Server STUN publik digunakan untuk mendeteksi IP publik NAT pengguna. (Pisahkan dengan koma)
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478"

# Server TURN Produksi (Relay)
# PERINGATAN: Layanan OpenRelay publik gratis TIDAK COCOK untuk produksi karena dibatasi bandwidth,
# latensi tidak menentu, rentan throttling, dan tidak memiliki jaminan uptime (SLA).
# Untuk produksi, gunakan salah satu dari:
#   a. Server coturn mandiri di VPS Linux (Ubuntu / Debian).
#   b. Layanan terkelola seperti Cloudflare Calls, Twilio Network Traversal, Xirsys, atau Metered.ca (paket berbayar).
#
# Format URL TURN: turn:host:port atau turn:host:port?transport=tcp / turns:host:port
TURN_SERVERS="turn:turn.domain-anda.com:3478,turn:turn.domain-anda.com:5349?transport=tcp"
TURN_USERNAME="username_turn_anda"
TURN_CREDENTIAL="password_turn_anda"

# ==============================================================================
# 2. Firebase Admin Credentials (Opsional, untuk Cloud Firestore & Storage)
# ==============================================================================
# Jika tidak diisi, server akan fallback menyimpan template dan aset secara lokal.
# FIREBASE_CREDENTIALS='{"type": "service_account", "project_id": "...", ...}'

